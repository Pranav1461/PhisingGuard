# PhishGuard Frontend Environment Variables
# Copy this file to `.env.local` and set values. NEVER commit real secrets.

# Leave empty in local development (Vite proxies /api to FastAPI on :8000).
# In production, point this at your deployed backend, e.g.:
# VITE_API_BASE_URL=https://your-backend-url.example.com/api
VITE_API_BASE_URL=

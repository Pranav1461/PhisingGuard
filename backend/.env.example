# PhishGuard Backend Environment Variables
# Copy this file to `.env` and fill in your own values. NEVER commit real secrets.

# Threat Intelligence Provider API Keys (Server-Side Only)
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLHAUS_AUTH_KEY=

# Database (Supabase PostgreSQL or local PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./phishguard.db

# CORS allowed origins (comma-separated). Add your Vercel frontend URL for production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
